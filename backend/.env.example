PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/opita_sync?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_MAX_SESSIONS_PER_USER=5
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
BOOTSTRAP_TENANT_SLUG=opita-admin
BOOTSTRAP_TENANT_NAME=Opita Admin Tenant
BOOTSTRAP_TENANT_TIMEZONE=America/Bogota
