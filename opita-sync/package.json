{
  "name": "opita-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first frontend and release surface for Opita Sync.",
  "type": "module",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "orchestrator:serve": "node scripts/serve-orchestrator.mjs",
    "codex:pick": "node scripts/codex-route.mjs",
    "codex:exec:auto": "node scripts/codex-route.mjs --exec",
    "codex:chat:auto": "node scripts/codex-route.mjs --chat",
    "router:benchmark": "node scripts/router-benchmark.mjs",
    "router:report": "node scripts/router-report.mjs",
    "router:calibrate": "node scripts/router-calibrate.mjs",
    "request:new": "node scripts/new-request.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "unit": "node --test tests/unit/**/*.test.mjs",
    "integration": "node --test tests/integration/**/*.test.mjs",
    "content": "node scripts/content-check.mjs",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:test": "npm --prefix backend run test",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm --prefix backend run prisma:deploy",
    "db:seed": "npm --prefix backend run prisma:seed",
    "db:reset": "npm --prefix backend run prisma:reset",
    "contracts:smoke:remote": "node scripts/remote-contract-smoke.mjs",
    "contracts:smoke:staging": "node scripts/remote-contract-smoke.mjs",
    "e2e": "npm run build:site && playwright test tests/e2e",
    "visual": "npm run build:site && playwright test tests/visual",
    "a11y": "npm run build:site && playwright test tests/a11y",
    "ci": "npm run lint && npm run typecheck && npm run unit && npm run integration && npm run content && npm run storybook:build && npm run e2e && npm run visual && npm run a11y"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.10.3",
    "postcss": "^8.5.8",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^5.4.19"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  }
}
