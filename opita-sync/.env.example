VITE_OPITA_DATA_SOURCE=stub
VITE_OPITA_API_BASE_URL=
VITE_OPITA_AUTH_STORAGE_KEY=opita-sync.session
VITE_OPITA_ENABLE_STUB_FALLBACK=true
VITE_OPITA_FAIL=
VITE_OPITA_FAIL_ONCE=
VITE_OPITA_AUTH_FAIL=
VITE_OPITA_AUTH_FAIL_ONCE=
OPITA_SMOKE_API_BASE_URL=
OPITA_SMOKE_ADMIN_EMAIL=
